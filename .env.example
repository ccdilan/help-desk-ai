APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ----------------------------------------------------------------------------
# PostgreSQL + pgvector (recommended)
#
# Vector similarity search (T3.1) requires PostgreSQL with the pgvector
# extension. SQLite still works for tests/local dev, but repository search
# features degrade gracefully (no AI code context).
#
# Enable the extension once per database: CREATE EXTENSION IF NOT EXISTS vector;
# ----------------------------------------------------------------------------
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=helpdesk
# DB_USERNAME=postgres
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------------------------------------------
# AI Provider (driver-based, see config/ai.php)
#
# AI_DRIVER selects the active driver; services depend on the EmbeddingClient /
# ChatClient contracts, so switching providers never requires code changes.
#
#   offline (default) — deterministic, key-free driver for tests/local dev.
#                       No network calls; replies are canned acknowledgements.
#   openai            — OpenAI or any OpenAI-compatible endpoint.
# ----------------------------------------------------------------------------
AI_DRIVER=offline

# Used when AI_DRIVER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_CHAT_MODEL=gpt-4o-mini

# Vector size for the offline driver (must match your embedding model's
# dimensions if you switch drivers and re-sync repositories)
AI_EMBEDDING_DIMENSIONS=1536

# ----------------------------------------------------------------------------
# GitHub App (see config/services.php)
#
# Required for repository connection, sync, and webhooks. The app runs without
# these in offline mode, but "Connect repository" will show a setup warning.
#
# GITHUB_APP_SLUG=cyntrek-ai-ticketing     # https://github.com/apps/<slug>
# GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
# GITHUB_CLIENT_SECRET=...
# GITHUB_WEBHOOK_SECRET=...
# ----------------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"
